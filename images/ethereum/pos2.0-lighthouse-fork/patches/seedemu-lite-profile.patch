+
+fn cap_non_zero_usize(value: NonZeroUsize, cap: usize) -> NonZeroUsize {
+    NonZeroUsize::new(value.get().min(cap).max(1)).expect("cap must produce non-zero usize")
+}
+
+fn apply_seedemu_lite_profile(config: &mut ClientConfig) {
+    config.store.block_cache_size = config.store.block_cache_size.min(1);
+    config.store.state_cache_size =
+        cap_non_zero_usize(config.store.state_cache_size, SEEDEMU_LITE_MAX_STATE_CACHE_SIZE);
+    config.store.state_cache_headroom = cap_non_zero_usize(config.store.state_cache_headroom, 1);
+    config.store.historic_state_cache_size =
+        cap_non_zero_usize(config.store.historic_state_cache_size, 1);
+    config.store.cold_hdiff_buffer_cache_size = cap_non_zero_usize(
+        config.store.cold_hdiff_buffer_cache_size,
+        SEEDEMU_LITE_MAX_HDIFF_BUFFER_CACHE_SIZE,
+    );
+    config.store.hot_hdiff_buffer_cache_size = cap_non_zero_usize(
+        config.store.hot_hdiff_buffer_cache_size,
+        SEEDEMU_LITE_MAX_HDIFF_BUFFER_CACHE_SIZE,
+    );
+    config.chain.shuffling_cache_size = config
+        .chain
+        .shuffling_cache_size
+        .min(SEEDEMU_LITE_MAX_SHUFFLING_CACHE_SIZE);
+    config.chain.enable_light_client_server = false;
+    config.beacon_processor.max_workers = config
+        .beacon_processor
+        .max_workers
+        .min(SEEDEMU_LITE_MAX_BEACON_PROCESSOR_WORKERS)
+        .max(1);
+    config.beacon_processor.max_work_event_queue_len = config
+        .beacon_processor
+        .max_work_event_queue_len
+        .min(SEEDEMU_LITE_MAX_WORK_QUEUE_LEN);
+    config.beacon_processor.max_scheduled_work_queue_len = config
+        .beacon_processor
+        .max_scheduled_work_queue_len
+        .min(SEEDEMU_LITE_MAX_REPROCESS_QUEUE_LEN);
+    config.beacon_processor.max_gossip_attestation_batch_size = config
+        .beacon_processor
+        .max_gossip_attestation_batch_size
+        .min(SEEDEMU_LITE_MAX_GOSSIP_BATCH_SIZE);
+    config.beacon_processor.max_gossip_aggregate_batch_size = config
+        .beacon_processor
+        .max_gossip_aggregate_batch_size
+        .min(SEEDEMU_LITE_MAX_GOSSIP_BATCH_SIZE);
+    info!("Applied SEED emulator Lighthouse low-memory profile");
+}
