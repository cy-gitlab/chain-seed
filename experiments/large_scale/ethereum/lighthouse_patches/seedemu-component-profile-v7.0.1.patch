+const SEEDEMU_LIGHTHOUSE_PROFILE_ENV: &str = "SEED_EMU_LIGHTHOUSE_PROFILE";
+const SEEDEMU_LIGHTHOUSE_COMPONENTS_ENV: &str = "SEED_EMU_LIGHTHOUSE_COMPONENTS";
+const SEEDEMU_LIGHTHOUSE_PROCESSOR_WORKERS_ENV: &str = "SEED_EMU_LIGHTHOUSE_MAX_PROCESSOR_WORKERS";
+const SEEDEMU_LITE_MAX_BLOCK_CACHE_SIZE: usize = 1;
+const SEEDEMU_LITE_MAX_STATE_CACHE_SIZE: usize = 4;
+const SEEDEMU_LITE_MAX_HDIFF_BUFFER_CACHE_SIZE: usize = 1;
+const SEEDEMU_LITE_MAX_SHUFFLING_CACHE_SIZE: usize = 1;
+const SEEDEMU_LITE_DEFAULT_MAX_BEACON_PROCESSOR_WORKERS: usize = 2;
+const SEEDEMU_LITE_MAX_WORK_QUEUE_LEN: usize = 2048;
+const SEEDEMU_LITE_MAX_REPROCESS_QUEUE_LEN: usize = 1024;
+const SEEDEMU_LITE_MAX_GOSSIP_BATCH_SIZE: usize = 16;
+
+fn seedemu_lite_profile_enabled() -> bool {
+    std::env::var(SEEDEMU_LIGHTHOUSE_PROFILE_ENV)
+        .map(|value| {
+            matches!(
+                value.to_ascii_lowercase().as_str(),
+                "1" | "true" | "yes" | "lite" | "low-memory" | "seedemu-lite"
+            )
+        })
+        .unwrap_or(false)
+}
+
+fn seedemu_lite_component_enabled(component: &str) -> bool {
+    if !seedemu_lite_profile_enabled() {
+        return false;
+    }
+
+    let Ok(raw_components) = std::env::var(SEEDEMU_LIGHTHOUSE_COMPONENTS_ENV) else {
+        return true;
+    };
+    let raw_components = raw_components.trim().to_ascii_lowercase();
+    if raw_components.is_empty() || raw_components == "all" {
+        return true;
+    }
+
+    raw_components
+        .split(|ch: char| ch == ',' || ch == ';' || ch.is_ascii_whitespace())
+        .filter(|token| !token.is_empty())
+        .any(|token| token == component || token == "all")
+}
+
+fn cap_non_zero_usize(value: NonZeroUsize, cap: usize) -> NonZeroUsize {
+    NonZeroUsize::new(value.get().min(cap).max(1)).expect("cap must produce non-zero usize")
+}
+
+fn seedemu_lite_processor_worker_cap() -> usize {
+    std::env::var(SEEDEMU_LIGHTHOUSE_PROCESSOR_WORKERS_ENV)
+        .ok()
+        .and_then(|raw| raw.trim().parse::<usize>().ok())
+        .filter(|value| *value > 0)
+        .unwrap_or(SEEDEMU_LITE_DEFAULT_MAX_BEACON_PROCESSOR_WORKERS)
+}
+
+fn apply_seedemu_lite_profile(config: &mut ClientConfig) {
+    if seedemu_lite_component_enabled("cache") {
+        config.store.block_cache_size =
+            cap_non_zero_usize(config.store.block_cache_size, SEEDEMU_LITE_MAX_BLOCK_CACHE_SIZE);
+        config.store.state_cache_size =
+            cap_non_zero_usize(config.store.state_cache_size, SEEDEMU_LITE_MAX_STATE_CACHE_SIZE);
+        config.store.state_cache_headroom =
+            cap_non_zero_usize(config.store.state_cache_headroom, 1);
+        config.store.historic_state_cache_size =
+            cap_non_zero_usize(config.store.historic_state_cache_size, 1);
+        config.store.hdiff_buffer_cache_size = cap_non_zero_usize(
+            config.store.hdiff_buffer_cache_size,
+            SEEDEMU_LITE_MAX_HDIFF_BUFFER_CACHE_SIZE,
+        );
+        config.chain.shuffling_cache_size = config
+            .chain
+            .shuffling_cache_size
+            .min(SEEDEMU_LITE_MAX_SHUFFLING_CACHE_SIZE);
+    }
+
+    if seedemu_lite_component_enabled("light-client") {
+        config.chain.enable_light_client_server = false;
+    }
+
+    if seedemu_lite_component_enabled("processor")
+        || seedemu_lite_component_enabled("processor-workers")
+    {
+        config.beacon_processor.max_workers = config
+            .beacon_processor
+            .max_workers
+            .min(seedemu_lite_processor_worker_cap())
+            .max(1);
+    }
+
+    if seedemu_lite_component_enabled("processor")
+        || seedemu_lite_component_enabled("processor-queues")
+    {
+        config.beacon_processor.max_work_event_queue_len = config
+            .beacon_processor
+            .max_work_event_queue_len
+            .min(SEEDEMU_LITE_MAX_WORK_QUEUE_LEN);
+        config.beacon_processor.max_scheduled_work_queue_len = config
+            .beacon_processor
+            .max_scheduled_work_queue_len
+            .min(SEEDEMU_LITE_MAX_REPROCESS_QUEUE_LEN);
+    }
+
+    if seedemu_lite_component_enabled("processor")
+        || seedemu_lite_component_enabled("processor-gossip")
+    {
+        config.beacon_processor.max_gossip_attestation_batch_size = config
+            .beacon_processor
+            .max_gossip_attestation_batch_size
+            .min(SEEDEMU_LITE_MAX_GOSSIP_BATCH_SIZE);
+        config.beacon_processor.max_gossip_aggregate_batch_size = config
+            .beacon_processor
+            .max_gossip_aggregate_batch_size
+            .min(SEEDEMU_LITE_MAX_GOSSIP_BATCH_SIZE);
+    }
+}
 
